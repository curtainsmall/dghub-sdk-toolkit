# Whitelist approach: ignore all, then un-ignore tracked content
*

# Root files
!.gitignore
!.gitattributes
!README.md
!CHANGELOG.md
!LICENSE

# Source directories
!.github/
!.github/**
!packer/
!packer/**
!sdk/
!sdk/**
!demo/
!demo/**
!docs/
!docs/**

# Re-ignore build outputs
packer/bin/
packer/installer/
packer/src/backend/_version.py
sdk/**/dist/
demo/**/vendor/
demo/**/*.zip
demo/**/debug/

# Re-ignore generated & cache
__pycache__/
*.pyc
*.egg-info/
cache/
output/
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# Re-ignore local project state
.dghub-sdk/
